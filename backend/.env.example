PORT=3000
YOUTUBE_API_KEY=
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=10mb
SLOW_REQUEST_THRESHOLD_MS=1000
APP_VERSION=local-dev

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin123
DATABASE_NAME=proyecto_materias
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
# El esquema de la base se crea y actualiza con migraciones.
# En produccion, start:prod ejecuta migration:run:prod antes de iniciar la API.

# Cuanto tiempo se reutiliza en memoria el usuario ya resuelto de la sesion
# (AuthSessionGuard corre en cada request autenticada). Subir este valor
# reduce consultas a "usuario" bajo carga; bajarlo a 0 lo desactiva.
SESSION_USER_CACHE_TTL_MS=10000

AUTH_SECRET=change-this-secret-to-at-least-32-characters
AUTH_ADMIN_EMAILS=
# Limite del flujo de login (/auth/signin y /auth/callback), por IP.
# /auth/session y /auth/csrf NO se limitan: se llaman en cada carga de
# pantalla y una universidad entera suele compartir una sola IP de salida.
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=300
# Limite global (ThrottlerModule). Las rutas autenticadas se limitan por
# usuario (UserAwareThrottlerGuard); solo las rutas @Public() siguen
# compartiendo cupo por IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
MAINTENANCE_CACHE_TTL_MS=5000
CURSADA_EXPIRATION_CHECK_INTERVAL_MS=60000
USER_LAST_ACCESS_WRITE_INTERVAL_MS=900000

GITEA_BASE_URL=https://gitea-dev.duckdns.org/
GITEA_CLIENT_ID=dev@unahur.edu.ar
GITEA_CLIENT_SECRET=vF2QZzGfVX9tHiH
GITEA_CALLBACK_URL=http://localhost:3000/auth/callback/gitea
GITEA_ADMIN_TOKEN=
GITEA_REQUEST_TIMEOUT_MS=15000
GITEA_USER_SYNC_ENABLED=true
GITEA_USER_SYNC_INTERVAL_MS=600000
GITEA_DEFAULT_REPO_VISIBILITY=private
GITEA_TEMPLATE_REPO_SUFFIX=-template
GITEA_IMPORT_DEFAULT_PASSWORD_FIELD=legajo
GITEA_IMPORT_MUST_CHANGE_PASSWORD=true
GITEA_WEBHOOK_ENABLED=false
GITEA_WEBHOOK_SECRET=
GITEA_WEBHOOK_PUBLIC_URL=http://localhost:3000/api/webhooks/gitea

FRONTEND_URL=http://localhost:3001/materias
FRONTEND_ORIGIN=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:3001
